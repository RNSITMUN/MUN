# =================================================================
# RNS MUN '26 - Environment Configuration Template
# Set these in Vercel Dashboard → Project Settings → Environment Variables
# For local development, create a .env.local file with these variables
# =================================================================

# ─── 1. Supabase Database & Storage Configuration ────────────────
# Retrieve from Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key
