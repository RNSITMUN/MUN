# =================================================================
# RNS MUN '26 - Environment Configuration Template
# Copy this file to .env.local for local development
# Set these in Vercel Dashboard → Project Settings → Environment Variables
# =================================================================

# ─── 1. Google Apps Script Web App URL ───────────────────────────
# Deploy google-apps-script.gs as a Web App (Execute as: Me, Access: Anyone)
# Used for BOTH individual delegate registration AND delegation sheet creation.
GOOGLE_APPS_SCRIPT_REGISTRATION_URL=https://script.google.com/macros/s/YOUR_REGISTRATION_SCRIPT_ID/exec

# Legacy delegation-only URL (kept for backward compatibility)
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_APPS_SCRIPT_DEPLOYMENT_ID/exec

# ─── 2. Google Master Registrations Sheet ID ─────────────────────
# The Sheet ID from the URL: docs.google.com/spreadsheets/d/SHEET_ID/edit
# Create a blank Google Sheet named "RNS MUN 26 - Master Registrations"
# and paste its ID here.
GOOGLE_MASTER_SHEET_ID=YOUR_MASTER_GOOGLE_SHEET_ID_HERE

# ─── 3. Google Drive Folder ID for Payment Screenshots ───────────
# Create a folder in Google Drive named "RNS MUN 26 - Payment Screenshots"
# and paste the folder ID from its URL here.
GOOGLE_DRIVE_SCREENSHOTS_FOLDER_ID=YOUR_GOOGLE_DRIVE_FOLDER_ID_HERE

# ─── 4. (Optional) Google Cloud Service Account Credentials ──────
# Only needed as a fallback if Apps Script webhook is unavailable.
# GOOGLE_SERVICE_ACCOUNT={"type":"service_account","client_email":"...","private_key":"..."}
# OR use individual vars:
# GOOGLE_CLIENT_EMAIL=your-service-account@project-id.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
# GOOGLE_PROJECT_ID=your-google-cloud-project-id
